datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  role          String    // ADMIN, CUSTOMER, AGENT
  phone         String?
  currentLat    Float?
  currentLng    Float?
  currentZoneId String?
  isAvailable   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  currentZone   Zone?     @relation(fields: [currentZoneId], references: [id])
  customerOrders Order[]  @relation("CustomerOrders")
  agentDeliveries Order[] @relation("AgentDeliveries")
  notifications Notification[]
}

model Zone {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  areas        Area[]
  agents       User[]
  pickupOrders Order[] @relation("PickupZone")
  dropOrders   Order[] @relation("DropZone")
}

model Area {
  id        String   @id @default(uuid())
  name      String
  pincode   String   @unique
  city      String
  zoneId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model RateCard {
  id           String   @id @default(uuid())
  orderType    String   // B2B, B2C
  zoneType     String   // INTRA, INTER
  baseWeight   Float    // Base weight allowance in kg
  baseRate     Float    // Flat base charge ($)
  perKgRate    Float    // Additional charge per kg above base weight ($)
  minCharge    Float    // Minimum guaranteed charge ($)
  codSurcharge Float    // COD surcharge ($)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orderType, zoneType])
}

model Order {
  id               String   @id @default(uuid())
  trackingNumber   String   @unique
  customerId       String
  agentId          String?
  orderType        String   // B2B, B2C
  paymentType      String   // PREPAID, COD
  pickupAddress    String
  pickupPincode    String
  pickupZoneId     String?
  pickupLat        Float?
  pickupLng        Float?
  dropAddress      String
  dropPincode      String
  dropZoneId       String?
  dropLat          Float?
  dropLng          Float?

  length           Float    // in cm
  width            Float    // in cm
  height           Float    // in cm
  actualWeight     Float    // in kg
  volumetricWeight Float    // in kg
  chargeableWeight Float    // in kg

  baseCharge       Float
  weightCharge     Float
  codSurcharge     Float
  totalCharge      Float

  status           String   // CREATED, PENDING_ASSIGNMENT, ASSIGNED, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, FAILED, RESCHEDULED, CANCELLED
  deliveryDate     DateTime?
  scheduledSlot    String?
  failureReason    String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer         User     @relation("CustomerOrders", fields: [customerId], references: [id])
  agent            User?    @relation("AgentDeliveries", fields: [agentId], references: [id])
  pickupZone       Zone?    @relation("PickupZone", fields: [pickupZoneId], references: [id])
  dropZone         Zone?    @relation("DropZone", fields: [dropZoneId], references: [id])

  trackingHistory  OrderTrackingHistory[]
  notifications    Notification[]
}

model OrderTrackingHistory {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  actorId   String?
  actorRole String   // SYSTEM, ADMIN, AGENT, CUSTOMER
  actorName String
  location  String?
  notes     String?
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  orderId   String?
  title     String
  message   String
  type      String   // EMAIL, SMS, IN_APP
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
}
